{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/frankp/process-runtime/schemas/extension-descriptor.schema.json",
  "title": "ExtensionDescriptor",
  "description": "DRAFT until ADR 0060 is Accepted (F1-WO1). ADR 0060 D2: one extension of one kind (D1), as its author declares it. The registry normalises it (D2: token levels `:0` dropped, clauses and their tokens sorted and deduplicated, `provides` keeping the highest level per (space, name), `modules` and `limitations` sorted) and hashes the normalised document without `status` (`descriptor_sha256`); the computed fields (`self_sha256`, `origin`, `evidence_class`, ...) are never declared. `payload` is validated by the kind's payload schema (`$defs/payload_<kind>` where one exists; a `preview` kind's payload need only be an object); a descriptor of the built-in table `legacy` (D6, F1-WO2) is validated by its kind's legacy form instead (`$defs/payload_<kind>_legacy`). `$defs/package` is D7's extension package document. Rules a JSON Schema cannot state (token spaces, D4; the namespace prefix, D7; `conn:<id>` of a connection definition) are `openflowsheet.registry`'s.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "descriptor_format",
    "kind",
    "id",
    "version",
    "title",
    "status",
    "requires",
    "provides",
    "limitations",
    "platforms",
    "pip_extra",
    "data_rights",
    "implementation",
    "payload"
  ],
  "properties": {
    "descriptor_format": {
      "const": "openflowsheet-extension-v1"
    },
    "kind": {
      "enum": [
        "property_method",
        "property_source",
        "unit_model",
        "connection_definition",
        "attribute_kind",
        "derived_quantity",
        "kinetics_kind",
        "stability_trial_set",
        "phase_family",
        "discrete_coordinate",
        "record_type",
        "correlation_form",
        "data_source",
        "record_generator",
        "solver_route",
        "run_kind",
        "functional_contributor",
        "exchange_format",
        "revision_section",
        "semantic_role",
        "equipment_class",
        "message_entries"
      ]
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "status": {
      "enum": [
        "declared",
        "implemented",
        "tested",
        "reviewed",
        "released"
      ]
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/token"
        }
      }
    },
    "provides": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/token"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "params"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "params": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number"
              ]
            }
          }
        }
      }
    },
    "platforms": {
      "anyOf": [
        {
          "type": "array",
          "const": [
            "any"
          ]
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "linux-x86_64",
              "linux-aarch64",
              "windows-x86_64",
              "macos-x86_64",
              "macos-arm64"
            ]
          }
        }
      ]
    },
    "pip_extra": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "data_rights": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "licence_stated"
          ],
          "properties": {
            "source": {
              "type": "string"
            },
            "licence_stated": {
              "type": "string"
            }
          }
        }
      ]
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modules",
        "factory"
      ],
      "properties": {
        "modules": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:(?!\\.\\.?/)[^/\\\\]+/)*(?!\\.\\.?$)[^/\\\\]+$"
          }
        },
        "factory": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "module",
                "attribute",
                "key"
              ],
              "properties": {
                "module": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
                },
                "attribute": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                "key": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "contributed_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "session",
        "date"
      ],
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "session": {
          "type": [
            "string",
            "null"
          ]
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "payload": {
      "type": "object"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*(\\.[A-Za-z0-9][A-Za-z0-9_-]*)*$"
    },
    "token": {
      "type": "string",
      "pattern": "^[a-z_]+:[A-Za-z0-9][A-Za-z0-9_.+-]*(:(0|[1-9][0-9]*))?$"
    },
    "payload_message_entries": {
      "description": "ADR 0060 D7: a YAML document in MSG's format (ADR 0058), read through `importlib.resources`.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalogue"
      ],
      "properties": {
        "catalogue": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "package",
            "path"
          ],
          "properties": {
            "package": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "pattern": "^(?:(?!\\.\\.?/)[^/\\\\]+/)*(?!\\.\\.?$)[^/\\\\]+$"
            }
          }
        }
      }
    },
    "payload_record_type": {
      "description": "ADR 0061 D1 (F3-WO1): a record type names its payload schema, a JSON pointer into a schema file the declaring package carries (`<package>/<path>` below its import root), and the SHA-256 of that file's LF-normalised bytes (review ruling WO1-11; checked at registration, `extension_invalid` on a mismatch); `null` only for a preview type whose payload another package owns (`assay`, X21). Every record type uses the record envelope and D2's identity rule.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_schema"
      ],
      "properties": {
        "payload_schema": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "package",
                "path",
                "pointer",
                "sha256"
              ],
              "properties": {
                "package": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "pattern": "^(?:(?!\\.\\.?/)[^/\\\\]+/)*(?!\\.\\.?$)[^/\\\\]+$"
                },
                "pointer": {
                  "type": "string",
                  "pattern": "^(/([^~/]|~[01])*)*$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          ]
        }
      }
    },
    "payload_correlation_form": {
      "description": "ADR 0061 D4 (F3-WO1): a correlation form's variables, coefficients (an entry's `coefficients` names exactly these), result kind, normative expression and evaluator. `evaluator` is preview until ADR-F4: F3 validates and stores, F4 evaluates.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variables",
        "coefficients",
        "result",
        "expression",
        "evaluator"
      ],
      "properties": {
        "variables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "kind",
              "unit"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "coefficients": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "kind",
              "unit"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "per_amount"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "per_amount": {
              "type": "boolean"
            }
          }
        },
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "evaluator": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "payload_data_source": {
      "description": "ADR 0061 D12 (F3-WO1): the record types a data source writes and the formats it reads.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_types",
        "formats"
      ],
      "properties": {
        "record_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        }
      }
    },
    "payload_attribute_kind": {
      "description": "ADR 0062 D5 (F2-WO2): an attribute kind's scope, partition and class flags, quantity kind, parent kind and admissibility inequalities (Q6.R5; `[coefficient, term]` sums, checked with the allowance τ_mono). F1 refuses a kind whose index set holds a definitional identity (`attribute_redundant`). No built-in in 0.5; F2's three probes are test-only registrations.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "partition",
        "classed",
        "quantity_kind",
        "parent_kind",
        "inequalities"
      ],
      "properties": {
        "scope": {
          "enum": [
            "component",
            "substream"
          ]
        },
        "partition": {
          "type": "boolean"
        },
        "classed": {
          "type": "boolean"
        },
        "quantity_kind": {
          "type": "string",
          "minLength": 1
        },
        "parent_kind": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "inequalities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lhs",
              "rhs",
              "allowance"
            ],
            "properties": {
              "lhs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string",
                      "minLength": 1
                    }
                  ],
                  "items": false,
                  "minItems": 2
                }
              },
              "rhs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string",
                      "minLength": 1
                    }
                  ],
                  "items": false,
                  "minItems": 2
                }
              },
              "allowance": {
                "const": "tau_mono"
              }
            }
          }
        }
      }
    },
    "payload_derived_quantity": {
      "description": "ADR 0062 D5 (F2-WO2): a derived quantity's inputs, auxiliary state points, output, quantity kind, degeneracy condition and expression. `expression` is preview: in 0.5 and 0.6 only `builtin` is admitted (T, β, s_mass, h_molar, x[c], w[c], ρ, bubble and dew T and P, built by ADR-F4/F5). `output` is a vocabulary item or `builtin`.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs",
        "auxiliary_points",
        "output",
        "quantity_kind",
        "degeneracy",
        "expression"
      ],
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "endpoint_kind"
            ],
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1
              },
              "endpoint_kind": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "auxiliary_points": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "spec",
              "candidates"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "spec": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "string",
                      "minLength": 1
                    }
                  ],
                  "items": false,
                  "minItems": 2
                }
              },
              "candidates": {
                "anyOf": [
                  {
                    "const": "method"
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                ]
              }
            }
          }
        },
        "output": {
          "anyOf": [
            {
              "const": "builtin"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "vocabulary_item"
              ],
              "properties": {
                "vocabulary_item": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "quantity_kind": {
          "type": "string",
          "minLength": 1
        },
        "degeneracy": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "expression": {
          "const": "builtin"
        }
      }
    },
    "payload_kinetics_kind": {
      "description": "ADR 0062 D5 (F2-WO2): a kinetics kind's core envelope; its rate expression is preview (in the revision's `reaction_sets[].kinetics` body).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writes",
        "indices"
      ],
      "properties": {
        "writes": {
          "const": "source_terms"
        },
        "indices": {
          "const": "any_carried"
        }
      }
    },
    "payload_phase_family": {
      "description": "ADR 0062 D6 (F2-WO2): a phase family is its id (`^[A-Z][A-Z0-9_]*$`; the built-ins VAPOR, LIQUID, FLUID, SOLID, in that registration order). Its vocabulary is the id; its semantics are ADR-F5's, so the payload is empty.",
      "type": "object",
      "additionalProperties": false
    },
    "payload_revision_section": {
      "description": "ADR 0062 D5 (F2-WO2): a revision section's schema (the JSON Schema `$id` its body validates against) and why the section exists. Sections enter `content_hash`; a section namespace's content is preview.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "reason"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "names": {
      "description": "A list of distinct non-empty names, in the order their source gives them.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "payload_property_method_legacy": {
      "description": "ADR 0060 D6: a legacy property method's payload, read by `scripts/registry_builtin.py` from the provider: `legacy_provider_id` is its module's `PROVIDER_ID`; `phases`, `flashes`, `properties`, `reference_convention` and `derivative_inputs` a constructed provider's `describe()` (`derivative_inputs` are the keys of its `derivative_order`); `bases` the `selectable_bases()` entries with its provider id; `selectable` whether `bases` is non-empty; `verifier_fresh` its membership in the verifier's `FRESH_PROVIDERS`. A provider constructed per component (`coolprop-heos-v1`, one per fluid) has `reference_convention` `per_component`, and `per_component` maps each component to the members that vary with it; its top-level `properties` and `derivative_inputs` are those every component declares, in describe order. `per_component` is null for every other provider.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legacy_provider_id",
        "phases",
        "flashes",
        "properties",
        "reference_convention",
        "per_component",
        "derivative_inputs",
        "bases",
        "selectable",
        "verifier_fresh"
      ],
      "properties": {
        "legacy_provider_id": {
          "type": "string",
          "minLength": 1
        },
        "phases": {
          "$ref": "#/$defs/names"
        },
        "flashes": {
          "$ref": "#/$defs/names"
        },
        "properties": {
          "$ref": "#/$defs/names"
        },
        "reference_convention": {
          "type": "string",
          "minLength": 1
        },
        "per_component": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "reference_convention",
                  "properties",
                  "derivative_inputs"
                ],
                "properties": {
                  "reference_convention": {
                    "type": "string",
                    "minLength": 1
                  },
                  "properties": {
                    "$ref": "#/$defs/names"
                  },
                  "derivative_inputs": {
                    "$ref": "#/$defs/names"
                  }
                }
              }
            }
          ]
        },
        "derivative_inputs": {
          "$ref": "#/$defs/names"
        },
        "bases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "record_source",
              "components"
            ],
            "properties": {
              "record_source": {
                "type": "string",
                "minLength": 1
              },
              "components": {
                "$ref": "#/$defs/names",
                "minItems": 1
              }
            }
          }
        },
        "selectable": {
          "type": "boolean"
        },
        "verifier_fresh": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "bases": {
                "maxItems": 0
              }
            }
          },
          "then": {
            "properties": {
              "selectable": {
                "const": false
              }
            }
          },
          "else": {
            "properties": {
              "selectable": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reference_convention": {
                "const": "per_component"
              }
            }
          },
          "then": {
            "properties": {
              "per_component": {
                "type": "object"
              }
            }
          },
          "else": {
            "properties": {
              "per_component": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "payload_unit_model_legacy": {
      "description": "ADR 0060 D6: a legacy unit's payload. `family` is the first segment of its id; `signature` is its `list_models` entry verbatim (ADR 0019 Amendment 2; the shape of `application-results.schema.json` `$defs/model_registry_view`), null iff `bindable` is false (only `syn001.cascade`).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "bindable",
        "signature"
      ],
      "properties": {
        "family": {
          "enum": [
            "syn001",
            "c1",
            "thermal"
          ]
        },
        "bindable": {
          "type": "boolean"
        },
        "signature": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "model_id",
                "ports",
                "required",
                "zero",
                "pins",
                "choices"
              ],
              "properties": {
                "model_id": {
                  "type": "string",
                  "minLength": 1
                },
                "ports": {
                  "type": "array"
                },
                "required": {
                  "type": "array"
                },
                "zero": {
                  "type": "array"
                },
                "pins": {
                  "type": "array"
                },
                "choices": {
                  "type": "array"
                }
              }
            }
          ]
        }
      },
      "if": {
        "properties": {
          "bindable": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "signature": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "signature": {
            "type": "object"
          }
        }
      }
    },
    "payload_connection_definition_legacy": {
      "description": "ADR 0060 D6: the legacy connection definition's payload (`nTP-v1`, ADR 0001 D2.1).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legacy",
        "state_definition"
      ],
      "properties": {
        "legacy": {
