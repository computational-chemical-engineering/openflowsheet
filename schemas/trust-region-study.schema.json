{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/computational-chemical-engineering/clearsheet/main/schemas/trust-region-study.schema.json",
  "title": "TrustRegionStudy",
  "description": "M05 design note \u00a79.1, ADRs 0038 and 0039: the record of one trust-region study (`trust-region-study-v1`). Built from `studies.trust_region.study.StudyResult.as_document`. The top level is closed; the nested run, candidate and spec objects require \u00a79.1's fields and tolerate the loop's additional detail (the configuration, the exit lines, a candidate's solves). `readiness`, `start`, `stage_a` and `best` are the record's own additions to \u00a79.1's list. A study that ends before a run (UNSUPPORTED, start not certified, budget exhausted) has empty `runs` and `candidates`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "spec",
    "environment",
    "runs",
    "candidates",
    "accounting",
    "status",
    "claims",
    "limitations",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "trust-region-study-v1"
    },
    "study_id": {
      "type": "string"
    },
    "spec": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "case",
        "revision_sha256",
        "decisions",
        "objective",
        "inequalities",
        "decision_tolerances",
        "budgets",
        "configs",
        "truth",
        "surrogate"
      ],
      "properties": {
        "case": {
          "type": "string"
        },
        "revision_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "decisions": {
          "type": "array"
        },
        "objective": {},
        "inequalities": {
          "type": "array"
        },
        "decision_tolerances": {
          "type": "object"
        },
        "budgets": {
          "type": "object"
        },
        "configs": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "trf",
            "trsp",
            "fd",
            "basis",
            "checks"
          ],
          "properties": {
            "trf": {
              "type": "string"
            },
            "trsp": {
              "type": "string"
            },
            "fd": {
              "type": "string"
            },
            "basis": {
              "type": "string"
            },
            "checks": {
              "type": "string"
            }
          }
        },
        "truth": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "kind",
            "id",
            "sha256",
            "synthetic"
          ],
          "properties": {
            "kind": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "sha256": {
              "anyOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            },
            "synthetic": {
              "type": "boolean"
            }
          }
        },
        "surrogate": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "manifest_sha256",
                "verdict"
              ],
              "properties": {
                "manifest_sha256": {
                  "$ref": "#/$defs/sha256"
                },
                "verdict": {
                  "type": "string"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "pyomo_version",
        "trf_module_sha256",
        "ipopt_version",
        "mumps_version",
        "trsp_executable_sha256",
        "platform"
      ],
      "properties": {
        "pyomo_version": {
          "type": "string"
        },
        "trf_module_sha256": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/sha256"
          }
        },
        "ipopt_version": {
          "type": "string"
        },
        "mumps_version": {
          "type": "string"
        },
        "trsp_executable_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "platform": {
          "type": "string"
        }
      }
    },
    "readiness": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reasons"
          ],
          "properties": {
            "status": {
              "enum": [
                "READY",
                "UNSUPPORTED"
              ]
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code",
                  "detail"
                ],
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "detail": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "start": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "stage_a": {
      "type": "object"
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "run_id",
          "stage",
          "study_iteration",
          "retry",
          "truth",
          "basis",
          "projection",
          "iterations",
          "filter",
          "outcome",
          "final",
          "ledger",
          "assumptions",
          "cold"
        ],
        "properties": {
          "run_id": {
            "type": "string"
          },
          "stage": {
            "enum": [
              "A",
              "C"
            ]
          },
          "study_iteration": {
            "type": "integer",
            "minimum": 0
          },
          "retry": {
            "enum": [
              0,
              1
            ]
          },
          "truth": {
            "type": "array"
          },
          "basis": {
            "type": "object"
          },
          "projection": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "source_map_sha256",
              "n_vars",
              "n_rows",
              "n_block_efs",
              "n_link_efs",
              "n_ineq"
            ],
            "properties": {
              "source_map_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "n_vars": {
                "type": "integer",
                "minimum": 0
              },
              "n_rows": {
                "type": "integer",
                "minimum": 0
              },
              "n_block_efs": {
                "type": "integer",
                "minimum": 0
              },
              "n_link_efs": {
                "type": "integer",
                "minimum": 0
              },
              "n_ineq": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "iterations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "k",
                "theta",
                "objective",
                "radius",
                "step_norm",
                "type"
              ],
              "properties": {
                "k": {
                  "type": "integer",
                  "minimum": 0
                },
                "theta": {
                  "type": "number"
                },
                "objective": {
                  "type": "number"
                },
                "radius": {
                  "type": "number"
                },
                "step_norm": {
                  "type": "number"
                },
                "type": {
                  "enum": [
                    "f",
                    "theta",
                    "rejected",
                    null
                  ]
                }
              },
              "description": "Iteration 0 is the PMP and takes no step (`type` null); every later iteration has a step type.",
              "if": {
                "properties": {
                  "k": {
                    "const": 0
                  }
                }
              },
              "then": {
                "properties": {
                  "type": {
                    "const": null
                  }
                }
              },
              "else": {
                "properties": {
                  "type": {
                    "enum": [
                      "f",
                      "theta",
                      "rejected"
                    ]
                  }
                }
              }
            }
          },
          "filter": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "f",
                "theta"
              ],
              "properties": {
                "f": {
                  "type": "number"
                },
                "theta": {
                  "type": "number"
                }
              }
            }
          },
          "outcome": {
            "type": "string"
          },
          "final": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "decisions",
                  "objective",
                  "theta"
                ],
                "properties": {
                  "decisions": {
                    "type": "object"
                  },
                  "objective": {
                    "type": "number"
                  },
                  "theta": {
                    "type": "number"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "ledger": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "summary"
            ],
            "properties": {
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "summary": {
                "type": "object"
              },
              "cold_parent": {
                "type": "integer",
                "minimum": 0
              }
            },
            "description": "\u00a79.1 lists {sha256, summary}; the producer writes {summary, cold_parent}. `sha256` is therefore not required (open point reported by WO-7)."
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "id",
                "status"
              ],
              "properties": {
                "id": {
                  "pattern": "^A[1-7]$",
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "pattern": "^(holds_by_construction|checked\\(.+\\)|assumed|qualified\\(.+\\)|limitation)$"
                }
              }
            }
          },
          "cold": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "candidate_id",
          "run_id",
          "decisions",
          "label",
          "revision_sha256",
          "checks",
          "poll",
          "noise_floor",
          "curvature",
          "indifference_halfwidth",
          "status",
          "limitations"
        ],
        "properties": {
          "candidate_id": {
            "type": "string"
          },
          "run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "stage": {
            "enum": [
              "A",
              "C"
            ]
          },
          "decisions": {
            "type": "object"
          },
          "label": {
            "const": "targeted_check"
          },
          "revision_sha256": {
            "anyOf": [
              {
                "$ref": "#/$defs/sha256"
              },
              {
                "type": "null"
              }
            ]
          },
          "checks": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "P1": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pass",
                  "values"
                ],
                "properties": {
                  "pass": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "values": {
                    "type": "object"
                  }
                }
              },
              "P2": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pass",
                  "values"
                ],
                "properties": {
                  "pass": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "values": {
                    "type": "object"
                  }
                }
              },
              "P3": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pass",
                  "values"
                ],
                "properties": {
                  "pass": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "values": {
                    "type": "object"
                  }
                }
              },
              "P4": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pass",
                  "values"
                ],
                "properties": {
                  "pass": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "values": {
                    "type": "object"
                  }
                }
              },
              "P5": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pass",
                  "values"
                ],
                "properties": {
                  "pass": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "values": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "poll": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "decisions",
                "J",
                "e",
                "feasible"
              ],
              "properties": {
                "decisions": {
                  "type": "object"
                },
                "J": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "e": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "feasible": {
                  "type": "boolean"
                }
              }
            }
          },
          "noise_floor": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "dJ_dX",
                  "dJ_dT",
                  "e_star"
                ],
                "properties": {
                  "dJ_dX": {
                    "type": "number"
                  },
                  "dJ_dT": {
                    "type": "number"
                  },
                  "e_star": {
                    "type": "number"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "curvature": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "indifference_halfwidth": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stopped_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "solves": {
            "type": "array"
          }
        }
      }
    },
    "best": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "check_id",
            "decisions",
            "objective",
            "stable"
          ],
          "properties": {
            "check_id": {
              "type": "string"
            },
            "decisions": {
              "type": "object"
            },
            "objective": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "stable": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totals",
        "by_stage",
        "by_iteration",
        "by_candidate",
        "budgets",
        "exhausted"
      ],
      "properties": {
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "trf_cold",
            "parent_executions",
            "store_hits",
            "parent_solves",
            "trf_runs"
          ],
          "properties": {
            "trf_cold": {
              "type": "integer",
              "minimum": 0
            },
            "parent_executions": {
              "type": "integer",
              "minimum": 0
            },
            "store_hits": {
              "type": "integer",
              "minimum": 0
            },
            "parent_solves": {
              "type": "integer",
              "minimum": 0
            },
            "trf_runs": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "by_stage": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "trf_cold",
              "parent_executions",
              "store_hits"
            ],
            "properties": {
              "trf_cold": {
                "type": "integer",
                "minimum": 0
              },
              "parent_executions": {
                "type": "integer",
                "minimum": 0
              },
              "store_hits": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "by_iteration": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "trf_cold",
              "parent_executions",
              "store_hits"
            ],
            "properties": {
              "trf_cold": {
                "type": "integer",
                "minimum": 0
              },
              "parent_executions": {
                "type": "integer",
                "minimum": 0
              },
              "store_hits": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "by_candidate": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "produce_trf_cold",
              "check_parent_executions"
            ],
            "properties": {
              "produce_trf_cold": {
                "type": "integer",
                "minimum": 0
              },
              "check_parent_executions": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "budgets": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "budget_id",
            "study_cold",
            "cold_used",
            "exhausted"
          ],
          "properties": {
            "budget_id": {
              "type": "string"
            },
            "study_cold": {
              "type": "integer",
              "minimum": 0
            },
            "cold_used": {
              "type": "integer",
              "minimum": 0
            },
            "exhausted": {
              "enum": [
                "cold",
                "wall",
                null
              ]
            }
          }
        },
        "exhausted": {
          "type": "boolean"
        }
      }
    },
    "status": {
      "type": "string",
      "pattern": "^(DECISION_STABLE|ITERATION_LIMIT|BUDGET_EXHAUSTED|FAILED\\(.+\\)|UNSUPPORTED\\(.+\\))$"
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "global_optimality",
        "trf_theory",
        "stationarity"
      ],
      "properties": {
        "global_optimality": {
          "const": false
        },
        "trf_theory": {
          "type": "string",
          "pattern": "^(assumptions_hold|qualified\\(.+\\))$"
        },
        "stationarity": {
          "enum": [
            "not_claimed",
            "poll_at_delta"
          ]
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "coupled_runs"
      ],
      "properties": {
        "source_map": {},
        "ledger": {},
        "coupled_runs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check_id",
              "sha256"
            ],
            "properties": {
              "check_id": {
                "type": "string"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
