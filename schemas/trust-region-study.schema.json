              "type": "integer",
              "minimum": 0
            },
            "fdcheck_point": {
              "type": "integer",
              "minimum": 0
            },
            "basis_fd_point": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "pmp_point_equals_start": {
          "type": "boolean"
