{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/computational-chemical-engineering/clearsheet/main/schemas/trust-region-study.schema.json",
  "title": "TrustRegionStudy",
  "description": "M05 design note §9.1 as amended by §18.4 (R-329), ADRs 0038 and 0039: the record of one trust-region study (`trust-region-study-v1`). Built from `studies.trust_region.study.StudyResult.as_document`. Every fixed-field object is closed and declares every field the producer writes (S14); id-keyed maps (decision ids, holder names, module names, EF names, units, stages, iterations, candidates) constrain only their values. `readiness`, `start`, `stage_a` and `best` are required, each an object or null (S13). The contents of `spec.decisions`, `spec.objective`, `spec.inequalities`, `spec.decision_tolerances` and `spec.budgets` are the caller's (build log S39). A study that ends before a run (UNSUPPORTED, start not certified, budget exhausted) has empty `runs` and `candidates`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "spec",
    "environment",
    "readiness",
    "start",
    "stage_a",
    "runs",
    "candidates",
    "best",
    "accounting",
    "status",
    "claims",
    "limitations",
    "fd_check",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "trust-region-study-v1"
    },
    "study_id": {
      "type": "string"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case",
        "revision_sha256",
        "decisions",
        "objective",
        "inequalities",
        "decision_tolerances",
        "budgets",
        "configs",
        "truth",
        "surrogate"
      ],
      "properties": {
        "case": {
          "type": "string"
        },
        "revision_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "decisions": {
          "type": "array"
        },
        "objective": {},
        "inequalities": {
          "type": "array"
        },
        "decision_tolerances": {
          "type": "object"
        },
        "budgets": {
          "type": "object"
        },
        "configs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "trf",
            "trsp",
            "fd",
            "basis",
            "checks"
          ],
          "properties": {
            "trf": {
              "type": "string"
            },
            "trsp": {
              "type": "string"
            },
            "fd": {
              "type": "string"
            },
            "basis": {
              "type": "string"
            },
            "checks": {
              "type": "string"
            }
          }
        },
        "truth": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "sha256",
            "synthetic"
          ],
          "properties": {
            "kind": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "sha256": {
              "anyOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            },
            "synthetic": {
              "type": "boolean"
            },
            "gradient": {
              "enum": [
                "analytic",
                "finite_difference"
              ]
            }
          }
        },
        "surrogate": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "manifest_sha256",
                "verdict"
              ],
              "properties": {
                "manifest_sha256": {
                  "$ref": "#/$defs/sha256"
                },
                "verdict": {
                  "type": "string"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pyomo_version",
        "trf_module_sha256",
        "ipopt_version",
        "mumps_version",
        "trsp_executable_sha256",
        "platform"
      ],
      "properties": {
        "pyomo_version": {
          "type": "string"
        },
        "trf_module_sha256": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/sha256"
          }
        },
        "ipopt_version": {
          "type": "string"
        },
        "mumps_version": {
          "type": "string"
        },
        "trsp_executable_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "platform": {
          "type": "string"
        }
      }
    },
    "readiness": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reasons"
          ],
          "properties": {
            "status": {
              "enum": [
                "READY",
                "UNSUPPORTED"
              ]
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code",
                  "detail"
                ],
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "detail": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "start": {
      "anyOf": [
        {
          "$ref": "#/$defs/parent_solve"
        },
        {
          "type": "null"
        }
      ]
    },
    "stage_a": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executed"
          ],
          "properties": {
            "executed": {
              "type": "boolean"
            },
            "reason": {
              "const": "surrogate_not_promoted"
            },
            "runs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "outcome": {
              "type": "string"
            }
          },
          "description": "Stage A (§7.3): skipped with its reason, or executed with its run ids and, after a second abort, the stopping status."
        },
        {
          "type": "object",
          "maxProperties": 0,
          "description": "The study stopped before stage A (UNSUPPORTED, start not certified, budget exhausted at S0)."
        },
        {
          "type": "null"
        }
      ]
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "stage",
          "study_iteration",
          "retry",
          "truth",
          "basis",
          "projection",
          "iterations",
          "filter",
          "outcome",
          "final",
          "ledger",
          "assumptions",
          "cold",
          "start_check_id",
          "radius_factor",
          "config",
          "exit_lines",
          "theta_recheck",
          "exit_claim",
          "theta_logged",
          "final_state_is_last_truth_point",
          "error"
        ],
        "properties": {
          "run_id": {
            "type": "string"
          },
          "stage": {
            "enum": [
              "A",
              "C"
            ]
          },
          "study_iteration": {
            "type": "integer",
            "minimum": 0
          },
          "retry": {
            "enum": [
              0,
              1
            ]
          },
          "truth": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/truth_identity"
            }
          },
          "basis": {
            "type": "object",
            "additionalProperties": {
              "enum": [
                "zero",
                "constant",
                "affine_taylor",
                "surrogate"
              ]
            },
            "description": "Each EF's basis kind (`EFBasis.kind`) by EF name."
          },
          "projection": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_map_sha256",
              "n_vars",
              "n_rows",
              "n_block_efs",
              "n_link_efs",
              "n_ineq"
            ],
            "properties": {
              "source_map_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "n_vars": {
                "type": "integer",
                "minimum": 0
              },
              "n_rows": {
                "type": "integer",
                "minimum": 0
              },
              "n_block_efs": {
                "type": "integer",
                "minimum": 0
              },
              "n_link_efs": {
                "type": "integer",
                "minimum": 0
              },
              "n_ineq": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "iterations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "k",
                "theta",
                "objective",
                "radius",
                "radius_logged",
                "step_norm",
                "type"
              ],
              "properties": {
                "k": {
                  "type": "integer",
                  "minimum": 0
                },
                "theta": {
                  "type": "number"
                },
                "objective": {
                  "type": "number"
                },
                "radius": {
                  "type": "number"
                },
                "radius_logged": {
                  "enum": [
                    "used",
                    "updated"
                  ]
                },
                "step_norm": {
                  "type": "number"
                },
                "type": {
                  "enum": [
                    "f",
                    "theta",
                    "rejected",
                    null
                  ]
                }
              },
              "description": "Iteration 0 is the PMP and takes no step (`type` null); every later iteration has a step type.",
              "if": {
                "properties": {
                  "k": {
                    "const": 0
                  }
                }
              },
              "then": {
                "properties": {
                  "type": {
                    "const": null
                  }
                }
              },
              "else": {
                "properties": {
                  "type": {
                    "enum": [
                      "f",
                      "theta",
                      "rejected"
                    ]
                  }
                }
              }
            }
          },
          "filter": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "f",
                "theta"
              ],
              "properties": {
                "f": {
                  "type": "number"
                },
                "theta": {
                  "type": "number"
                }
              }
            }
          },
          "outcome": {
            "type": "string"
          },
          "final": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "decisions",
                  "objective",
                  "theta"
                ],
                "properties": {
                  "decisions": {
                    "$ref": "#/$defs/decisions"
                  },
                  "objective": {
                    "type": "number"
                  },
                  "theta": {
                    "type": "number"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "ledger": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "summary",
              "cold_parent"
            ],
            "properties": {
              "summary": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/holder_summary"
                }
              },
              "cold_parent": {
                "type": "integer",
                "minimum": 0
              }
            },
            "description": "S12: each truth holder's summary over the run, by holder name, and the run's cold parent requests. The ledger itself is `artifacts.ledger`."
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "status"
              ],
              "properties": {
                "id": {
                  "pattern": "^A[1-7]$",
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "pattern": "^(holds_by_construction|checked\\(.+\\)|assumed|qualified\\(.+\\)|limitation)$"
                }
              }
            }
          },
          "cold": {
            "type": "integer",
            "minimum": 0
          },
          "start_check_id": {
            "type": "string"
          },
          "radius_factor": {
            "type": "number"
          },
          "config": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            },
            "description": "TRF's effective configuration, by option name."
          },
          "exit_lines": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "theta_recheck": {
            "type": [
              "number",
              "null"
            ]
          },
          "exit_claim": {
            "enum": [
              "optimal",
              "feasible",
              null
            ]
          },
          "theta_logged": {
            "type": [
              "number",
              "null"
            ]
          },
          "final_state_is_last_truth_point": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "description": "One TRF run: `TrfStageRunner`'s document and the loop's keys. `exit_claim`, `theta_logged`, `theta_recheck` and `final_state_is_last_truth_point` are null when TRF raised (W4)."
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "run_id",
          "decisions",
          "label",
          "revision_sha256",
          "checks",
          "poll",
          "noise_floor",
          "curvature",
          "indifference_halfwidth",
          "status",
          "limitations",
          "stage",
          "stopped_by",
          "solves"
        ],
        "properties": {
          "candidate_id": {
            "type": "string"
          },
          "run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "stage": {
            "enum": [
              "A",
              "C"
            ]
          },
          "decisions": {
            "$ref": "#/$defs/decisions"
          },
          "label": {
            "const": "targeted_check"
          },
          "revision_sha256": {
            "anyOf": [
              {
                "$ref": "#/$defs/sha256"
              },
              {
                "type": "null"
              }
            ]
          },
          "checks": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "P1": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pass",
                  "values"
                ],
                "properties": {
                  "pass": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "values": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "check_id",
                      "outcome",
                      "certificate"
                    ],
                    "properties": {
                      "check_id": {
                        "type": "string"
                      },
                      "outcome": {
                        "type": "string"
                      },
                      "certificate": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                }
              },
              "P2": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pass",
                  "judged",
                  "reason",
                  "values"
                ],
                "properties": {
                  "pass": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "judged": {
                    "type": "boolean"
                  },
                  "reason": {
                    "enum": [
                      null,
                      "no_trf_point",
                      "theta_recheck"
                    ]
                  },
                  "values": {
                    "anyOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "applicable"
                        ],
                        "properties": {
                          "applicable": {
                            "const": false
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "reference",
                          "objective_trf",
                          "objective_reference",
                          "objective_error",
                          "objective_bound",
                          "n_mapped",
                          "worst_state",
                          "worst_state_variable",
                          "final_state_checks_failed",
                          "theta_recheck",
                          "feasibility_termination"
                        ],
                        "properties": {
                          "reference": {
                            "type": "string"
                          },
                          "objective_trf": {
                            "type": "number"
                          },
                          "objective_reference": {
                            "type": "number"
                          },
                          "objective_error": {
                            "type": "number"
                          },
                          "objective_bound": {
                            "type": "number"
                          },
                          "n_mapped": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "worst_state": {
                            "type": "number"
                          },
                          "worst_state_variable": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "final_state_checks_failed": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "theta_recheck": {
                            "type": "number"
                          },
                          "feasibility_termination": {
                            "type": "number"
                          }
                        }
                      }
                    ],
                    "description": "P2 without a TRF point (`applicable: false`), else `gross_agreement`'s values."
                  }
                }
              },
              "P3": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pass",
                  "values"
                ],
                "properties": {
                  "pass": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "values": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "n",
                      "violated",
                      "worst_scaled_violation"
                    ],
                    "properties": {
                      "n": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "violated": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "worst_scaled_violation": {
                        "type": "number"
                      }
                    }
                  }
                }
              },
              "P4": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pass",
                  "values"
                ],
                "properties": {
                  "pass": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "values": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "changed"
                    ],
                    "properties": {
                      "changed": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "reference",
                            "found"
                          ],
                          "properties": {
                            "reference": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "found": {
                              "type": [
                                "string",
                                "null"
                              ]
                            }
                          }
                        },
                        "description": "By unit: the reference (S0's) and the found regime label."
                      }
                    }
                  }
                }
              },
              "P5": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pass",
                  "values"
                ],
                "properties": {
                  "pass": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "values": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "points",
                      "n_feasible"
                    ],
                    "properties": {
                      "points": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "check_id",
                            "improvement",
                            "allowance",
                            "pass"
                          ],
                          "properties": {
                            "check_id": {
                              "type": "string"
                            },
                            "improvement": {
                              "type": "number"
                            },
                            "allowance": {
                              "type": "number"
                            },
                            "pass": {
                              "type": "boolean"
                            }
                          }
                        }
                      },
                      "n_feasible": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  }
                }
              }
            }
          },
          "poll": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "decision",
                "direction",
                "decisions",
                "clipped",
                "check_id",
                "J",
                "e",
                "feasible",
                "regimes_match"
              ],
              "properties": {
                "decision": {
                  "type": "string"
                },
                "direction": {
                  "enum": [
                    -1,
                    1
                  ]
                },
                "decisions": {
                  "$ref": "#/$defs/decisions"
                },
                "clipped": {
                  "type": "boolean"
                },
                "check_id": {
                  "type": "string"
                },
                "J": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "e": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "feasible": {
                  "type": "boolean"
                },
                "regimes_match": {
                  "type": "boolean"
                }
              }
            }
          },
          "noise_floor": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "dJ_dX",
                  "dJ_dT",
                  "e_star",
                  "h_X",
                  "h_T",
                  "inner"
                ],
                "properties": {
                  "dJ_dX": {
                    "type": "number"
                  },
                  "dJ_dT": {
                    "type": "number"
                  },
                  "e_star": {
                    "type": "number"
                  },
                  "h_X": {
                    "type": "number"
                  },
                  "h_T": {
                    "type": "number"
                  },
                  "inner": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "w",
                        "J"
                      ],
                      "properties": {
                        "w": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          }
                        },
                        "J": {
                          "type": "number"
                        }
                      }
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "curvature": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "indifference_halfwidth": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              {
                "type": "null"
              }
            ],
            "description": "S15/S36: per decision id, √(2(e* + max e_j)/|c|) ≥ 0, or null where it is undefined; the whole field is null iff P5 did not run. The bound is ≥ 0, not > 0: a parent with no noise (e* = e_j = 0) gives exactly 0.0 (build log S36)."
          },
          "status": {
            "type": "string"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stopped_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "solves": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/parent_solve"
            }
          }
        }
      }
    },
