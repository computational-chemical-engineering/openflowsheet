{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/frankp/process-runtime/schemas/application-results.schema.json",
  "title": "ApplicationResults",
  "description": "T07 design note §11.3–§11.4 and ruling round 4 (W5a-Q2); ADR 0019 Amendment 1. The response shapes of the JobControl and Inspection operations in `OPERATIONS` that have no published schema of their own, one `$def` each, named in snake_case after the Python result type (`types.py`, `contract.py`), a page `<item>_page`. The members are those `operations.py` stated at `9b541df`, moved unchanged. Every string and key of a response is bounded (§10.4) before it is carried. `job`, `job-event`, `job_result`, `run-result`, `transaction-result`, `validation-report` and `replay-report` stay in their own schemas, referenced from here.",
  "$defs": {
    "submit_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job",
        "replayed"
      ],
      "properties": {
        "job": {
          "$ref": "https://github.com/frankp/process-runtime/schemas/job.schema.json"
        },
        "replayed": {
          "type": "boolean"
        }
      }
    },
    "job_page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "next_cursor"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "https://github.com/frankp/process-runtime/schemas/job.schema.json"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        }
      }
    },
    "job_event_page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "next_cursor"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "https://github.com/frankp/process-runtime/schemas/job-event.schema.json"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        }
      }
    },
    "job_wait": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ended",
        "events",
        "job"
      ],
      "properties": {
        "job": {
          "$ref": "https://github.com/frankp/process-runtime/schemas/job.schema.json"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "https://github.com/frankp/process-runtime/schemas/job-event.schema.json"
          }
        },
        "ended": {
          "type": "boolean"
        }
      }
    },
    "project_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "default_policy_id",
        "head",
        "job_counts",
        "limits",
        "principal_id",
        "project_id",
        "revision_count",
        "rights",
        "server",
        "solve_policies"
      ],
      "properties": {
        "project_id": {
          "type": "string"
        },
        "head": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision_count": {
          "type": "integer",
          "minimum": 0
        },
        "job_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "solve_policies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "policy_id",
              "policy_sha256"
            ],
            "properties": {
              "policy_id": {
                "type": "string"
              },
              "policy_sha256": {
                "$ref": "https://github.com/frankp/process-runtime/schemas/job.schema.json#/$defs/sha256"
              }
            }
          }
        },
        "default_policy_id": {
          "type": "string"
        },
        "principal_id": {
          "$ref": "https://github.com/frankp/process-runtime/schemas/job.schema.json#/$defs/id"
        },
        "capability_id": {
          "$ref": "https://github.com/frankp/process-runtime/schemas/job.schema.json#/$defs/id"
        },
        "rights": {
          "$ref": "https://github.com/frankp/process-runtime/schemas/capability-reference.schema.json#/properties/rights"
        },
        "limits": {
          "$ref": "https://github.com/frankp/process-runtime/schemas/capability-reference.schema.json#/properties/limits"
        },
        "server": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "git_commit",
            "package_version",
            "store_schema"
          ],
          "properties": {
            "package_version": {
              "type": "string"
            },
            "git_commit": {
              "type": [
                "string",
                "null"
              ]
            },
            "store_schema": {
              "type": "string"
            }
          }
        }
      }
    },
    "model_registry_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "models"
      ],
      "properties": {
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "choices",
              "model_id",
              "pins",
              "ports",
              "required",
              "zero"
            ],
            "properties": {
              "model_id": {
                "type": "string"
              },
              "ports": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "direction",
                    "kind",
                    "multiplicity",
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "direction": {
                      "type": "string"
                    },
                    "multiplicity": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 1
                        },
                        {
                          "const": "many"
                        }
                      ]
                    },
                    "kind": {
                      "type": "string"
                    }
                  }
                }
              },
              "required": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "zero": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "pins": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "port",
                    "quantity",
                    "specifications"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "quantity": {
                      "enum": [
                        "flow",
                        "temperature",
                        "pressure",
                        "duty"
                      ]
                    },
                    "port": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "specifications": {
                      "type": "array",
                      "minItems": 1,
                      "description": "ADR 0019 Amendment 2 (T07 design note ruling round 6, B2): the encodings the revision binder reads for this pin, `pin_encodings` of its `ModelSignature` over the target-path table. `object_id` is a template: `{instance}` is the instance's id, `{connection:<port>}` the connection wired to that port; `component` `{component}` is one specification per component of the revision's set; `fixes` names the pins one such specification pins.",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "component",
                          "fixes",
                          "kind",
                          "object_id",
                          "object_type",
                          "path",
                          "si_unit"
                        ],
                        "properties": {
                          "object_type": {
                            "enum": [
                              "instance",
                              "connection"
                            ]
                          },
                          "object_id": {
                            "type": "string",
                            "pattern": "^\\{(instance|connection:[^}]+)\\}$"
                          },
                          "path": {
                            "type": "string"
                          },
                          "component": {
                            "enum": [
                              "{component}",
                              null
                            ]
                          },
                          "kind": {
                            "$ref": "https://github.com/frankp/process-runtime/schemas/quantity.schema.json#/$defs/kind"
                          },
                          "si_unit": {
                            "type": "string"
                          },
                          "fixes": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "choices": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "options"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "options": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "name",
                          "port",
                          "quantity",
                          "specifications"
                        ],
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "quantity": {
                            "enum": [
                              "flow",
                              "temperature",
                              "pressure",
                              "duty"
                            ]
                          },
                          "port": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "specifications": {
                            "type": "array",
                            "minItems": 1,
                            "description": "ADR 0019 Amendment 2 (T07 design note ruling round 6, B2): the encodings the revision binder reads for this pin, `pin_encodings` of its `ModelSignature` over the target-path table. `object_id` is a template: `{instance}` is the instance's id, `{connection:<port>}` the connection wired to that port; `component` `{component}` is one specification per component of the revision's set; `fixes` names the pins one such specification pins.",
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "component",
                                "fixes",
                                "kind",
                                "object_id",
                                "object_type",
                                "path",
                                "si_unit"
                              ],
                              "properties": {
                                "object_type": {
                                  "enum": [
                                    "instance",
                                    "connection"
                                  ]
                                },
                                "object_id": {
                                  "type": "string",
                                  "pattern": "^\\{(instance|connection:[^}]+)\\}$"
                                },
                                "path": {
                                  "type": "string"
                                },
                                "component": {
                                  "enum": [
                                    "{component}",
                                    null
                                  ]
                                },
                                "kind": {
                                  "$ref": "https://github.com/frankp/process-runtime/schemas/quantity.schema.json#/$defs/kind"
                                },
                                "si_unit": {
                                  "type": "string"
                                },
                                "fixes": {
                                  "type": "array",
                                  "minItems": 1,
                                  "items": {
                                    "type": "string"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "revision_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_sha256",
        "created_at",
        "head",
        "parent_revision",
        "principal_id",
        "revision_id",
        "title"
      ],
      "properties": {
        "revision_id": {
          "type": "string"
        },
        "parent_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "content_sha256": {
          "$ref": "https://github.com/frankp/process-runtime/schemas/job.schema.json#/$defs/sha256"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "principal_id": {
          "type": "string"
        },
        "created_at": {
          "$ref": "https://github.com/frankp/process-runtime/schemas/job.schema.json#/$defs/timestamp"
        },
        "head": {
          "type": "boolean"
        }
      }
    },
    "revision_page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "next_cursor"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/revision_summary"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "next_cursor",
        "pointer",
        "sha256",
        "subject_id",
        "truncated",
        "value"
      ],
      "properties": {
        "subject_id": {
          "type": "string"
        },
        "pointer": {
          "type": "string"
        },
        "sha256": {
          "$ref": "https://github.com/frankp/process-runtime/schemas/job.schema.json#/$defs/sha256"
        },
        "value": {},
        "truncated": {
          "type": "boolean"
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        }
      }
    },
    "semantic_diff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "changed",
        "elements",
        "removed"
      ],
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "elements": {
          "description": "ADR 0019 Amendment 3 (A3.2; M06 design note §4.2): the items of `instances`, `connections` and `specifications` that differ, paired by `id` (`transactions.element_diff`); `id` is null when a member's items cannot be paired. Ordered by member, then by `id` in code-point order; `paths` are the key paths inside a `changed` item, from its root, in code-point order. `diff_revisions` only: `transaction-result`'s `diff` has no such member.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "change",
              "id",
              "member",
              "paths"
            ],
            "properties": {
              "member": {
                "enum": [
                  "instances",
                  "connections",
                  "specifications"
                ]
              },
              "id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "change": {
                "enum": [
                  "added",
                  "removed",
                  "changed"
                ]
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "audit_record": {
      "description": "ADR 0019 Amendment 3 (A3.3; M06 design note §4.3): one row of the project's audit (§10.7), an effect or a refusal, as the store holds it. `effect` is `<kind>:<id>`; `idempotency_key` is the ledger's key of an `allowed` row with the same principal, operation and request hash, else null.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "capability_id",
        "code",
        "effect",
        "idempotency_key",
        "operation",
        "outcome",
        "principal_id",
        "request_sha256",
        "seq"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "at": {
          "$ref": "https://github.com/frankp/process-runtime/schemas/job.schema.json#/$defs/timestamp"
        },
        "principal_id": {
          "type": "string"
        },
        "capability_id": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "allowed",
            "refused"
          ]
        },
        "code": {
          "type": [
            "string",
            "null"
          ]
        },
        "request_sha256": {
          "anyOf": [
            {
              "$ref": "https://github.com/frankp/process-runtime/schemas/job.schema.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "effect": {
          "type": [
            "string",
            "null"
          ]
        },
        "idempotency_key": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "audit_page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "next_cursor"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/audit_record"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        }
      }
    }
  }
}
